{
  "manifest_version": 3,
  "name": "MIDO XI Capture",
  "version": "0.1.0",
  "description": "Save football moments from YouTube directly to your MIDO XI Player OS.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MIDO XI Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://mido-xi.vercel.app/*",
    "http://localhost:3100/*",
    "http://localhost:3000/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Capture the current moment"
    }
  }
}
