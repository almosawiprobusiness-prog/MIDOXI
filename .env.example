# ============================================================
# MIDO XI — Environment
# Copy to .env.local and fill in. The app runs in DEMO MODE
# (seed data, no persistence) until the Supabase vars are set.
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (Milestone A: auth + database + storage) ----
# Project Settings → API. URL + anon (publishable) key are public/client-safe.
# The service_role key is SECRET — server-only, never NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (Milestone A: Google sign-in) ----
# Configured in the Supabase dashboard (Auth → Providers → Google).
# These are only needed if you wire OAuth outside Supabase's managed flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI provider (Milestone C: MIDO intelligence) — Anthropic ----
ANTHROPIC_API_KEY=
# Optional override of the default model routing (fast|standard|deep)
MIDO_AI_MODEL_FAST=
MIDO_AI_MODEL_STANDARD=
MIDO_AI_MODEL_DEEP=

# ---- Native video reading (film room) — Gemini ----
# Claude reads images, not video. Reading the CLIP rather than stills of it
# needs a model family that ingests video natively, so it is a second key.
#
# Genuinely optional: without it the film room keeps its frame reader, the
# "read the clip" option reports itself unavailable with the reason, and
# nothing else in the product changes.
GEMINI_API_KEY=
# Optional. Model ids move faster than deployments; set this to pin one or to
# use a cheaper lite variant. The saved analysis records whichever ran.
GEMINI_VIDEO_MODEL=
# Vertex AI (Gemini Enterprise Agent Platform) — the enterprise-terms home
# for the same models; the consumer API's terms bar under-18-directed
# services. Set BOTH key and project and the Gemini client speaks Vertex
# instead of AI Studio; remove them to roll back. Location defaults to
# "global". Note: no Files API on Vertex — uploads travel inline (≤12MB);
# YouTube links are unaffected.
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=

# ---- YouTube Data API (Milestone C: study discovery) ----
YOUTUBE_API_KEY=

# ---- Stripe (Milestone D: MIDO Pro membership) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ---- Email (Milestone E: transactional) — Resend ----
RESEND_API_KEY=
MIDO_FROM_EMAIL=MIDO XI <no-reply@example.com>

# ---- Observability (Milestone E) — Sentry ----
NEXT_PUBLIC_SENTRY_DSN=

# ---- Admin (internal economics dashboard) ----
# Comma-separated list of admin user emails.
MIDO_ADMIN_EMAILS=

# ---- MIDO XI Capture (Chrome extension) ----
# Comma-separated Chrome extension ids allowed to call /api/extension/*.
# Unset = any chrome-extension:// origin (fine for dev; pin in production).
# The id is stable because extension/manifest.json carries a fixed "key".
MIDO_EXTENSION_IDS=
